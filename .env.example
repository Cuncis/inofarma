APP_NAME=Inofarma
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
UPLOADS_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2 (S3-compatible) — only needed once UPLOADS_DISK=s3. R2 is
# driven through filesystems.php's s3 disk, so it reuses the AWS_* names;
# key/secret come from Cloudflare dashboard > R2 > Manage API tokens,
# AWS_ENDPOINT from the bucket's Settings page (S3 API endpoint), AWS_URL
# from the bucket's public dev/custom domain (r2.dev or a connected domain).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

# DOKU Checkout (Fase 6). Client-Id and Secret Key come from the DOKU Back
# Office; DOKU_PRODUCTION=false uses api-sandbox.doku.com.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PRODUCTION=false

# Biteship (Fase 7). API key from the Biteship dashboard's Integrations page
# (biteship_test.* while "Testing Mode" is on, biteship_live.* once activated
# for production). BITESHIP_WEBHOOK_TOKEN is one you generate yourself and
# also paste into the Notification URL's `?token=` query string when adding
# the webhook in the Biteship dashboard — Biteship's webhooks carry no
# signature of their own, so this token is what authenticates them.
BITESHIP_API_KEY=
BITESHIP_WEBHOOK_TOKEN=

# WhatsApp Cloud API (Fase 8) — Meta's own official Business API. Token +
# phone number id come from the Meta Business/App dashboard. The two
# template names must already be approved in that same WhatsApp Business
# Account before either notification can actually send — see
# App\Support\Notifications\WhatsAppClient.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_ORDER_SHIPPED=pesanan_dikirim
WHATSAPP_TEMPLATE_ORDER_READY=pesanan_siap_diambil

# Transactional email (Fase 8) — set MAIL_MAILER=ses in production. The
# AWS_* keys above are Cloudflare R2's, not real AWS IAM credentials, so SES
# needs its own AWS access key/secret set separately; verify the sending
# domain and configure SPF/DKIM/DMARC in Amazon SES first. Local dev keeps
# MAIL_MAILER=log — nothing is actually sent.

# Storefront location picker (Shop/LocationPickerModal.jsx). A browser key
# from Google Cloud Console (restrict it by HTTP referrer, not a secret) with
# "Maps JavaScript API" and "Places API" enabled and billing active.
VITE_GOOGLE_MAPS_API_KEY=

VITE_APP_NAME="${APP_NAME}"
